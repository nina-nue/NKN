# Web3Forms Access Key (Pflicht für ein funktionierendes Kontaktformular).
# Kostenlos erzeugbar unter https://web3forms.com — niemals den echten Key
# committen, diese Datei dient nur als Vorlage.
PUBLIC_WEB3FORMS_KEY=

# Basis-Domain der Seite (Sitemap, Canonical-URLs, JSON-LD, OG-Bild).
PUBLIC_SITE_URL=https://www.nina-nuechter.de

# Plausible Analytics (optional). Nur wirksam, wenn beide Werte gesetzt
# sind UND der Besuch der Statistik-Kategorie im Consent-Banner zustimmt.
# Ohne PUBLIC_ENABLE_ANALYTICS=true zeigt das Banner nur "Notwendig".
PUBLIC_ENABLE_ANALYTICS=false
PUBLIC_PLAUSIBLE_DOMAIN=
