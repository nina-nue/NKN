---
/**
 * Bild-Slot mit automatischem Fallback: liegt die Datei in src/assets/images/
 * vor, wird sie über astro:assets optimiert ausgegeben (WebP, feste Maße).
 * Fehlt sie noch, erscheint ein deutlich beschrifteter Platzhalter im
 * richtigen Seitenverhältnis, damit später nichts im Layout umbricht.
 *
 * Bilder bewusst NICHT in public/images/, sondern in src/assets/images/:
 * nur Bilder innerhalb von src/ werden von astro:assets zu WebP/AVIF
 * verarbeitet — public/ wird unverändert kopiert (keine Optimierung möglich).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  filename: string;
  alt: string;
  label: string;
  ratio: '4/5' | '3/2' | '1/1' | '16/9';
  width: number;
  height: number;
  class?: string;
  sizes?: string;
  priority?: boolean;
}

const {
  filename,
  alt,
  label,
  ratio,
  width,
  height,
  class: className = '',
  sizes,
  priority = false,
} = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*', {
  eager: true,
});
const match = images[`/src/assets/images/${filename}`];

const ratioClass: Record<Props['ratio'], string> = {
  '4/5': 'aspect-[4/5]',
  '3/2': 'aspect-[3/2]',
  '1/1': 'aspect-square',
  '16/9': 'aspect-video',
};
---

{
  match ? (
    <Image
      src={match.default}
      alt={alt}
      width={width}
      height={height}
      sizes={sizes}
      format="webp"
      quality="mid"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      class={`${ratioClass[ratio]} w-full object-cover ${className}`}
    />
  ) : (
    <div
      class={`${ratioClass[ratio]} ${className} flex w-full flex-col items-center justify-center gap-2 border-2 border-dashed border-border-strong bg-surface-alt p-6 text-center`}
      role="img"
      aria-label={alt}
    >
      <span class="text-sm font-semibold text-ink-muted">{label}</span>
      <span class="text-xs text-ink-muted">{ratio.replace('/', ':')}, hier einsetzen</span>
    </div>
  )
}
