---
import { problems } from '../data/problems';
---

<section class="bg-surface-alt" aria-labelledby="probleme-heading">
  <div class="section-pad mx-auto max-w-(--container-max) px-4 sm:px-6">
    <h2 id="probleme-heading" class="sr-only">Typische Situationen in Organisationen</h2>
    <div class="grid gap-6 sm:grid-cols-2">
      {
        problems.map((problem) => (
          <div
            data-reveal
            class="card-lift rounded-lg border border-border bg-surface-raised p-7 shadow-card"
          >
            <p class="font-sans text-xl leading-snug text-primary-strong">„{problem.situation}"</p>
            <p class="mt-4 text-ink-soft">{problem.response}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
