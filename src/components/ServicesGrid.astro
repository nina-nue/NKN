---
import { ChevronDown } from '@lucide/astro';
import { services } from '../data/services';
---

<section
  id="leistungen"
  class="scroll-mt-20 border-b border-border bg-surface-alt"
  aria-labelledby="leistungen-heading"
>
  <div class="mx-auto max-w-(--container-max) px-4 py-20 sm:px-6">
    <div class="max-w-2xl" data-reveal>
      <p class="text-sm font-semibold uppercase tracking-wide text-accent-strong">Leistungen</p>
      <h2 id="leistungen-heading" class="mt-3 font-sans text-3xl text-primary-strong sm:text-4xl">
        Neun Bausteine, ein Ziel
      </h2>
      <p class="mt-4 text-lg text-ink-soft">
        Jede Leistung lässt sich einzeln buchen oder in einem Paket kombinieren. Zum Aufklappen
        antippen oder alle Details auf einen Blick auf der{' '}
        <a href="/leistungen" class="underline underline-offset-2 hover:text-primary">
          Leistungsseite
        </a>{' '}
        ansehen.
      </p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2">
      {
        services.map((service) => (
          <details
            data-reveal
            class="group rounded-lg border border-border bg-surface-raised open:shadow-card"
          >
            <summary class="flex cursor-pointer list-none items-start justify-between gap-4 p-6">
              <div>
                <span class="text-xs font-semibold uppercase tracking-wide text-accent-strong">
                  {service.phase}
                </span>
                <h3 class="mt-1 font-sans text-lg text-primary-strong">{service.title}</h3>
                <p class="mt-2 text-sm text-ink-soft">{service.summary}</p>
              </div>
              <ChevronDown
                class="mt-1 h-5 w-5 shrink-0 text-ink-muted transition-transform group-open:rotate-180"
                aria-hidden="true"
              />
            </summary>
            <div class="px-6 pb-6 text-sm leading-relaxed text-ink-soft">{service.description}</div>
          </details>
        ))
      }
    </div>
  </div>
</section>
