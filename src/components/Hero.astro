---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Hero „zentriert": bildschirmfüllendes Foto mit mittig zentriertem Text.
 * Löst die vorherige Variante mit seitlich positioniertem Motiv + Parallax ab.
 *
 * Drei Verlaufs-Ebenen sorgen für Lesbarkeit, ohne das Foto zuzudecken:
 *  1. Heller Verlauf oben    -> hält die fixe (transparente) Navigation lesbar
 *  2. Radialer dunkler Verlauf mittig -> Kontrast für den weißen Textblock
 *  3. Dunkler Verlauf unten  -> Kontrast für den Scroll-Hinweis
 *
 * Zwei Stellschrauben, falls der Bildausschnitt nicht perfekt sitzt:
 *  1. object-position am <Image>     -> verschiebt den sichtbaren Bildausschnitt
 *  2. padding-top/-bottom am Textblock -> schiebt den Textblock nach oben/unten
 *
 * Das Foto wird aus src/assets/images/ geladen und über astro:assets zu
 * WebP optimiert (responsive srcset). Fehlt die Datei, erscheint ein heller
 * Platzhalter im vollen Format — das Layout bleibt identisch.
 */

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*', {
  eager: true,
});
const hero = images['/src/assets/images/Gemini_Generated_Image_pmolq9pmolq9pmol.png'];
---

<section
  id="start"
  class="relative flex min-h-[100svh] w-full items-center justify-center overflow-hidden bg-surface"
>
  {
    hero ? (
      <Image
        src={hero.default}
        alt="Beratungsgespräch in einem hellen, modernen Büro"
        widths={[768, 1280, 1920, 2560]}
        sizes="100vw"
        format="webp"
        quality="mid"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover"
        style="object-position: 50% 38%;"
      />
    ) : (
      <div
        class="absolute inset-0 flex items-center justify-center"
        style="background: linear-gradient(115deg,#eee6d5 0%,#d9e0d2 55%,#b9c6b2 100%);"
      >
        <span class="rounded-md border border-dashed border-border-strong px-4 py-2 text-sm text-ink-muted">
          Ihr Foto — hier als Gemini_Generated_Image_pmolq9pmolq9pmol.png einsetzen (vollflächig)
        </span>
      </div>
    )
  }

  <!-- Verlauf: oben hell für die Navigation, mittig dunkel für den Text, unten dunkel für den Scroll-Hinweis -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0"
    style="background:
      linear-gradient(to bottom, color-mix(in srgb, var(--color-surface) 92%, transparent) 0%, color-mix(in srgb, var(--color-surface) 45%, transparent) 9%, transparent 20%),
      radial-gradient(115% 80% at 50% 46%, color-mix(in srgb, var(--color-ink) 58%, transparent) 0%, color-mix(in srgb, var(--color-ink) 42%, transparent) 42%, color-mix(in srgb, var(--color-ink) 10%, transparent) 100%),
      linear-gradient(to bottom, transparent 58%, color-mix(in srgb, var(--color-ink) 40%, transparent) 100%);"
  />

  <div
    class="relative z-10 mx-auto flex w-full max-w-(--container-max) flex-col items-center px-4 text-center sm:px-6"
    style="padding-top: clamp(6rem, 14vh, 9rem); padding-bottom: clamp(7rem, 24vh, 15rem); transform: translateY(1cm);"
    data-reveal="rise"
  >
    <p class="flex items-center gap-4 text-[0.8rem] font-semibold uppercase tracking-[0.18em] text-accent-strong">
      <span aria-hidden="true" class="h-px w-8 bg-accent-strong opacity-60 sm:w-16" />
      KI-Beratung für den Mittelstand
      <span aria-hidden="true" class="h-px w-8 bg-accent-strong opacity-60 sm:w-16" />
    </p>

    <h1
      class="mt-7 max-w-[16ch] text-balance text-5xl font-bold leading-[1.02] tracking-[-0.025em] text-ink-on-primary sm:text-6xl lg:text-7xl xl:text-8xl"
      style="text-shadow: 0 2px 30px color-mix(in srgb, var(--color-ink) 35%, transparent);"
    >
      KI scheitert selten an der Technik.
    </h1>

    <p class="mt-7 max-w-[56ch] text-pretty text-lg leading-relaxed text-ink-on-primary/90 sm:text-xl">
      Sondern daran, dass sie im Alltag nicht ankommt. Ich begleite mittelständische Unternehmen
      dabei, KI so einzuführen, dass das Team sie tatsächlich nutzt — mit dem Blick einer
      Organisationspsychologin.
    </p>

    <div class="mt-10 flex w-full max-w-[340px] flex-col items-center gap-4 sm:w-auto sm:max-w-none sm:flex-row sm:justify-center">
      <a href="/#kontakt" class="btn-primary px-8 py-4 text-base">Kostenfreies Erstgespräch</a>
      <a href="/#ablauf" class="btn-secondary bg-surface/90 px-8 py-4 text-base backdrop-blur">
        Wie ich arbeite
      </a>
    </div>
  </div>

  <a
    href="/#ablauf"
    aria-label="Weiter zum nächsten Abschnitt"
    class="hero-scroll-hint pointer-events-auto absolute bottom-8 left-1/2 z-10 flex -translate-x-1/2 flex-col items-center gap-3 text-[0.72rem] uppercase tracking-[0.28em] text-ink-on-primary/85 transition-opacity hover:text-ink-on-primary"
  >
    Scrollen
    <span
      aria-hidden="true"
      class="h-8 w-px"
      style="background: linear-gradient(to bottom, color-mix(in srgb, var(--color-ink-on-primary) 90%, transparent), transparent);"
    />
  </a>
</section>
