---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Hero „hell & modern": vollflächiges Hintergrundfoto, Motiv rechts
 * positioniert, heller Verlauf links, Text links. Farb-Wash + Vignette
 * beruhigen den unruhigen Konferenz-Hintergrund (Messewand/Lanyard), ohne
 * die Person freizustellen. Scroll-Parallax + sanfter Zoom-in beim Laden.
 *
 * Das Foto wird aus src/assets/images/hero.jpg geladen und über astro:assets
 * zu WebP optimiert. Fehlt die Datei, erscheint ein heller Platzhalter im
 * vollen Format — das Layout bleibt identisch.
 */

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*', {
  eager: true,
});
const hero = images['/src/assets/images/hero.jpg'];
---

<section class="relative flex min-h-[92svh] items-center overflow-hidden bg-surface">
  {
    hero ? (
      <div class="hero-media" data-hero-parallax>
        <Image
          src={hero.default}
          alt="Nina Karolin Nüchter bei einer Veranstaltung"
          widths={[768, 1280, 1920, 2560]}
          sizes="100vw"
          format="webp"
          quality="mid"
          loading="eager"
          fetchpriority="high"
          style="object-position: 72% 20%;"
        />
      </div>
    ) : (
      <div
        class="hero-media flex items-center justify-end pr-16"
        style="background: linear-gradient(115deg,#eee6d5 0%,#d9e0d2 55%,#b9c6b2 100%);"
        data-hero-parallax
      >
        <span class="rounded-md border border-dashed border-border-strong px-4 py-2 text-sm text-ink-muted">
          Ihr Foto — hier als hero.jpg einsetzen (vollflächig)
        </span>
      </div>
    )
  }

  <!-- Farb-Wash: zieht kühle Banner-/Lanyard-Töne im Foto Richtung Marke -->
  <div class="hero-wash pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <!-- Radialer Spotlight-Vignette: dunkelt Ränder ab, lenkt den Blick zur Person -->
  <div class="hero-vignette pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <!-- Heller Verlauf-Scrim: links deckend für Textlesbarkeit, rechts frei fürs Motiv, unten dezenter Fade -->
  <div class="hero-scrim pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto w-full max-w-(--container-max) px-4 py-24 sm:px-6">
    <div class="max-w-2xl" data-reveal="rise">
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-accent-strong">
        KI-Beratung für den Mittelstand
      </p>
      <h1
        class="mt-5 text-balance text-5xl leading-[0.98] text-primary-strong sm:text-6xl lg:text-7xl xl:text-8xl"
      >
        KI scheitert selten an der Technik.
      </h1>
      <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink-soft sm:text-xl">
        Sondern daran, dass sie im Alltag nicht ankommt. Ich begleite mittelständische Unternehmen
        dabei, KI so einzuführen, dass das Team sie tatsächlich nutzt — mit dem Blick einer
        Organisationspsychologin.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a href="/#kontakt" class="btn-primary px-7 py-4 text-base"> Kostenfreies Erstgespräch </a>
        <a href="/#ablauf" class="btn-secondary bg-surface/60 px-7 py-4 text-base backdrop-blur">
          Wie ich arbeite
        </a>
      </div>
    </div>
  </div>

  <div
    class="hero-scroll-hint pointer-events-none absolute bottom-7 left-1/2 z-10 text-xs uppercase tracking-[0.25em] text-ink-muted"
  >
    Scrollen
  </div>
</section>

<script>
  const media = document.querySelector<HTMLElement>('[data-hero-parallax]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (media && !reduce) {
    let ticking = false;
    const update = () => {
      const y = window.scrollY;
      // Foto langsamer als der Scroll (Apple-artiger Parallax)
      media.style.transform = `translate3d(0, ${y * 0.18}px, 0)`;
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );
    update();
  }
</script>
