---
import { packages, singleModules, pricingIntro, pricingFootnote } from '../data/pricing';
import { ChevronDown } from '@lucide/astro';
---

<section id="preise" class="scroll-mt-20 bg-surface" aria-labelledby="preise-heading">
  <div class="section-pad mx-auto max-w-(--container-max) px-4 sm:px-6">
    <div class="max-w-2xl" data-reveal="rise">
      <p class="text-sm font-semibold uppercase tracking-wide text-accent-strong">
        Preise & Pakete
      </p>
      <h2 id="preise-heading" class="mt-3 font-sans text-fluid-h2 text-primary-strong">
        Drei Pakete, klar zusammengesetzt
      </h2>
      <p class="mt-4 text-lg text-ink-soft">
        Jedes Paket besteht aus benannten Bausteinen. Was einzeln buchbar ist, sehen Sie in der
        Paketkarte — und weiter unten als eigenständiges Angebot.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {
        packages.map((pkg) => (
          <div
            data-reveal
            class={`flex flex-col rounded-lg border bg-surface-raised p-7 transition-transform duration-300 ease-out hover:-translate-y-1 hover:shadow-raised ${
              pkg.highlighted
                ? 'border-primary shadow-raised lg:scale-[1.03]'
                : 'border-border shadow-card'
            }`}
          >
            <h3 class="font-sans text-xl text-primary-strong">{pkg.name}</h3>
            <p class="mt-2 font-sans text-2xl text-ink">{pkg.price}</p>
            <p class="mt-3 text-sm text-ink-soft">{pkg.audience}</p>

            <div class="mt-5 flex flex-wrap gap-2">
              {pkg.modules.map((mod) => (
                <span class="rounded-full border border-border bg-surface-alt px-3 py-1 text-xs text-ink-soft">
                  {mod}
                </span>
              ))}
            </div>

            <div class="mt-6 border-t border-border pt-5">
              <p class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Ergebnis</p>
              <p class="mt-2 text-sm text-ink-soft">{pkg.result}</p>
            </div>

            <a
              href="/#kontakt"
              class={`mt-6 inline-block rounded-md px-5 py-3 text-center text-sm font-semibold transition-all ${
                pkg.highlighted
                  ? 'bg-primary text-ink-on-primary hover:bg-primary-strong hover:shadow-raised'
                  : 'border border-primary text-primary-strong hover:bg-primary-soft'
              }`}
            >
              Anfragen
            </a>
          </div>
        ))
      }
    </div>

    <div data-reveal class="mt-14">
      <details class="group rounded-lg border border-border bg-surface-raised">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-6">
          <span class="font-sans text-xl text-primary-strong">Oder einzeln buchen</span>
          <ChevronDown
            class="h-5 w-5 shrink-0 text-ink-muted transition-transform group-open:rotate-180"
            aria-hidden="true"
          />
        </summary>
        <div class="px-6 pb-6">
          <p class="text-ink-soft">{pricingIntro}</p>
          <ul class="mt-5 divide-y divide-border border-t border-border">
            {
              singleModules.map((mod) => (
                <li class="flex flex-col gap-1 py-4 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
                  <div>
                    <p class="font-medium text-ink">{mod.name}</p>
                    <p class="text-sm text-ink-muted">{mod.scope}</p>
                  </div>
                  <p class="shrink-0 text-sm font-medium text-ink-soft sm:text-right">
                    Auf Anfrage
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </details>
    </div>

    <p class="mt-8 max-w-2xl text-sm text-ink-muted" data-reveal>{pricingFootnote}</p>
  </div>
</section>
