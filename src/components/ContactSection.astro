---
import ContactForm from './ContactForm.astro';
import { site } from '../data/site';
import { Mail, Calendar } from '@lucide/astro';
---

<section id="kontakt" class="scroll-mt-20 bg-surface" aria-labelledby="kontakt-heading">
  <div class="mx-auto max-w-(--container-max) px-4 py-20 sm:px-6">
    <div class="max-w-2xl" data-reveal>
      <p class="text-sm font-semibold uppercase tracking-wide text-accent-strong">Kontakt</p>
      <h2 id="kontakt-heading" class="mt-3 font-serif text-3xl text-primary-strong sm:text-4xl">
        Ein erster, unverbindlicher Schritt
      </h2>
      <p class="mt-4 text-lg text-ink-soft">
        Ein kostenfreies Erstgespräch, 30 Minuten, ohne Verpflichtung. Wir schauen offen, ob und wo
        KI bei Ihnen überhaupt sinnvoll ist.
      </p>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-[1.3fr_1fr]">
      <div
        data-reveal
        class="rounded-lg border border-border bg-surface-raised p-7 shadow-card sm:p-8"
      >
        <h3 class="font-serif text-xl text-primary-strong">Nachricht schreiben</h3>
        <div class="mt-6">
          <ContactForm />
        </div>
      </div>

      <div class="flex flex-col gap-6">
        <div data-reveal class="rounded-lg border border-border bg-surface-alt p-7">
          <Mail class="h-6 w-6 text-primary" aria-hidden="true" />
          <h3 class="mt-3 font-serif text-lg text-primary-strong">Direkt per E-Mail</h3>
          <p class="mt-2 text-sm text-ink-soft">
            Wenn Ihnen eine kurze E-Mail lieber ist als das Formular.
          </p>
          <a
            href={`mailto:${site.email}`}
            class="mt-4 inline-block font-medium text-primary-strong underline underline-offset-2 hover:text-primary"
          >
            {site.email}
          </a>
        </div>

        <div data-reveal class="rounded-lg border border-border bg-surface-alt p-7">
          <Calendar class="h-6 w-6 text-primary" aria-hidden="true" />
          <h3 class="mt-3 font-serif text-lg text-primary-strong">Termin direkt buchen</h3>
          <p class="mt-2 text-sm text-ink-soft">
            30 Minuten, direkt in meinem Kalender. Öffnet in einem neuen Tab bei Calendly — dabei
            werden Daten an Calendly, USA, übertragen (Details in der{' '}
            <a href="/datenschutz" class="underline underline-offset-2 hover:text-primary">
              Datenschutzerklärung
            </a>
            ).
          </p>
          <a
            href={site.calendlyUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-block rounded-md bg-primary px-5 py-2.5 text-sm font-semibold text-ink-on-primary transition-colors hover:bg-primary-strong"
          >
            Termin direkt buchen
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!--
  Variante B (Calendly-Inline-Embed hinter Einwilligung) ist vorbereitet in
  components/CalendlyEmbed.astro, aber bewusst nicht aktiv. Bei Bedarf:

  import CalendlyEmbed from './CalendlyEmbed.astro';
  ...
  <CalendlyEmbed />  statt des Buttons oben einsetzen.
-->
