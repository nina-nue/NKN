---
import ContactForm from './ContactForm.astro';
import { site } from '../data/site';
import { Mail, Calendar } from '@lucide/astro';
---

<section id="kontakt" class="scroll-mt-20 bg-surface" aria-labelledby="kontakt-heading">
  <div class="section-pad mx-auto max-w-(--container-max) px-4 sm:px-6">
    <div class="max-w-2xl" data-reveal="rise">
      <p class="text-sm font-semibold uppercase tracking-wide text-accent-strong">Kontakt</p>
      <h2 id="kontakt-heading" class="mt-3 font-sans text-fluid-h2 text-primary-strong">
        Ein erster, unverbindlicher Schritt
      </h2>
      <p class="mt-4 text-lg text-ink-soft">
        Ein kostenfreies Erstgespräch, 30 Minuten, ohne Verpflichtung. Wir schauen offen, ob und wo
        KI bei Ihnen überhaupt sinnvoll ist.
      </p>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-[1.3fr_1fr]">
      <div
        data-reveal
        class="card-lift rounded-lg border border-border bg-surface-raised p-7 shadow-card sm:p-8"
      >
        <h3 class="font-sans text-xl text-primary-strong">Nachricht schreiben</h3>
        <div class="mt-6">
          <ContactForm />
        </div>
      </div>

      <div class="flex flex-col gap-6">
        <div data-reveal class="card-lift rounded-lg border border-border bg-surface-alt p-7">
          <Mail class="h-6 w-6 text-primary" aria-hidden="true" />
          <h3 class="mt-3 font-sans text-lg text-primary-strong">Direkt per E-Mail</h3>
          <a
            href={`mailto:${site.email}`}
            class="mt-4 inline-block font-medium text-primary-strong underline underline-offset-2 hover:text-primary"
          >
            {site.email}
          </a>
        </div>

        <div data-reveal class="card-lift rounded-lg border border-border bg-surface-alt p-7">
          <Calendar class="h-6 w-6 text-primary" aria-hidden="true" />
          <h3 class="mt-3 font-sans text-lg text-primary-strong">Termin direkt buchen</h3>
          <p class="mt-2 text-sm text-ink-soft">
            30 Minuten, direkt in meinem Kalender. Öffnet in einem neuen Tab bei Calendly — dabei
            werden Daten an Calendly, USA, übertragen (Details in der{' '}
            <a href="/datenschutz" class="underline underline-offset-2 hover:text-primary">
              Datenschutzerklärung
            </a>
            ).
          </p>

          <div class="mt-4">
            <label for="booking-region" class="block text-sm font-medium text-ink"
              >In welcher Region ist Ihr Unternehmen ansässig? *</label
            >
            <select
              id="booking-region"
              required
              class="mt-1.5 w-full rounded-md border border-border bg-surface-raised px-4 py-2.5 text-ink transition-colors focus:border-primary"
            >
              <option value="">Bitte wählen</option>
              <option value="duisburg">Duisburg</option>
              <option value="kreis-wesel">Kreis Wesel</option>
              <option value="kreis-kleve">Kreis Kleve</option>
              <option value="andere">Andere Region</option>
            </select>
          </div>

          <div id="booking-blocked-notice" class="mt-4 hidden text-sm text-ink-soft">
            <p>
              Für Unternehmen aus dieser Region nehme ich aktuell keine Aufträge an — mehr dazu
              auf der{' '}
              <a href="/transparenz" class="underline underline-offset-2 hover:text-primary">
                Transparenz-Seite
              </a>. Es gibt für diese Region ein kostenfreies, öffentlich gefördertes
              Beratungsangebot zum Thema KI:{' '}
              <a
                href="https://linktr.ee/KIfuerKMU"
                target="_blank"
                rel="noopener noreferrer"
                class="underline underline-offset-2 hover:text-primary"
              >
                linktr.ee/KIfuerKMU
              </a>.
            </p>
          </div>

          <a
            href={site.calendlyUrl}
            target="_blank"
            rel="noopener noreferrer"
            id="booking-cta"
            class="btn-primary mt-4 hidden px-5 py-2.5 text-sm"
          >
            Termin direkt buchen
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!--
  Variante B (Calendly-Inline-Embed hinter Einwilligung) ist vorbereitet in
  components/CalendlyEmbed.astro, aber bewusst nicht aktiv. Bei Bedarf:

  import CalendlyEmbed from './CalendlyEmbed.astro';
  ...
  <CalendlyEmbed />  statt des Buttons oben einsetzen.
-->

<script>
  const bookingRegion = document.getElementById('booking-region') as HTMLSelectElement | null;
  const bookingCta = document.getElementById('booking-cta');
  const bookingBlockedNotice = document.getElementById('booking-blocked-notice');
  const blockedBookingRegions = new Set(['duisburg', 'kreis-wesel', 'kreis-kleve']);

  function updateBookingGate() {
    const value = bookingRegion?.value ?? '';
    const blocked = blockedBookingRegions.has(value);
    const chosen = value !== '';
    bookingBlockedNotice?.classList.toggle('hidden', !blocked);
    bookingCta?.classList.toggle('hidden', !(chosen && !blocked));
  }

  bookingRegion?.addEventListener('change', updateBookingGate);
  updateBookingGate();
</script>
