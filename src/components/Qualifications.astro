---
import { education, experience, methods } from '../data/qualifications';
---

<section class="bg-surface-alt" aria-labelledby="qualifikation-heading">
  <div class="section-pad mx-auto max-w-(--container-max) px-4 sm:px-6">
    <div class="max-w-2xl" data-reveal="rise">
      <p class="text-sm font-semibold uppercase tracking-wide text-accent-strong">Qualifikation</p>
      <h2 id="qualifikation-heading" class="mt-3 font-sans text-fluid-h2 text-primary-strong">
        Fachlicher Hintergrund
      </h2>
    </div>

    <div class="mt-10 grid gap-10 sm:grid-cols-2">
      <div data-reveal>
        <h3 class="font-sans text-lg text-primary-strong">Ausbildung</h3>
        <ul class="mt-4 space-y-3">
          {
            education.map((item) => (
              <li class="flex gap-3 text-ink-soft">
                <span class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                <span>{item.label}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div data-reveal>
        <h3 class="font-sans text-lg text-primary-strong">Praxis</h3>
        <ul class="mt-4 space-y-3">
          {
            experience.map((item) => (
              <li class="flex gap-3 text-ink-soft">
                <span class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                <span>{item.label}</span>
              </li>
            ))
          }
        </ul>

        <h3 class="mt-8 font-sans text-lg text-primary-strong">Methoden & Tools</h3>
        <p class="mt-4 text-ink-soft">{methods.join(' · ')}</p>
      </div>
    </div>
  </div>
</section>
