---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlaceholderImage from '../../components/PlaceholderImage.astro';
import { services } from '../../data/services';
import { phases } from '../../data/phases';

const title = 'Leistungen im Detail — KI-Beratung von Nina Karolin Nüchter';
const description =
  'Alle Leistungen im Überblick: KI-Potenzialanalyse, Strategie & Roadmap, Change-Begleitung, Schulung, Governance, Pilotbegleitung, Wirkungsmessung und mehr — zugeordnet zu den vier Phasen der Zusammenarbeit.';

const grouped = phases.map((phase) => ({
  phase,
  items: services.filter((service) => service.phase === phase.title),
}));
---

<BaseLayout title={title} description={description}>
  <section class="border-b border-border bg-surface">
    <div class="mx-auto max-w-(--container-max) px-4 py-16 sm:px-6 sm:py-20">
      <p class="text-sm font-semibold uppercase tracking-wide text-accent-strong">Leistungen</p>
      <h1 class="mt-3 max-w-2xl font-sans text-4xl text-primary-strong sm:text-5xl">
        Alle Leistungen im Detail
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-ink-soft">
        Jede Leistung ist einer der vier Phasen zugeordnet, mit denen ich arbeite — Analyse,
        Strategie, Befähigung, Verankerung. Einzeln buchbar oder als Paket, siehe{' '}
        <a href="/#preise" class="underline underline-offset-2 hover:text-primary">
          Preise & Pakete
        </a>.
      </p>
    </div>
  </section>

  <section class="border-b border-border bg-surface-alt">
    <div class="mx-auto max-w-(--container-max) px-4 py-14 sm:px-6">
      <PlaceholderImage
        filename="workshop-1.jpg"
        alt="Workshop-Situation mit Nina Karolin Nüchter und einem Team"
        label="Workshop — 3:2, hier einsetzen"
        ratio="3/2"
        width={1200}
        height={800}
        class="rounded-lg shadow-card"
      />
    </div>
  </section>

  {
    grouped.map(({ phase, items }, index) => (
      <section
        class={`border-b border-border ${index % 2 === 0 ? 'bg-surface' : 'bg-surface-alt'}`}
      >
        <div class="mx-auto max-w-(--container-max) px-4 py-16 sm:px-6">
          <div class="flex items-baseline gap-4">
            <span class="font-sans text-2xl text-accent-strong">{phase.number}</span>
            <h2 class="font-sans text-2xl text-primary-strong sm:text-3xl">{phase.title}</h2>
          </div>
          <p class="mt-2 max-w-xl text-ink-soft">{phase.summary}</p>

          <div class="mt-8 grid gap-6 sm:grid-cols-2">
            {items.map((service) => (
              <div
                id={service.slug}
                class="scroll-mt-20 rounded-lg border border-border bg-surface-raised p-6"
              >
                <h3 class="font-sans text-lg text-primary-strong">{service.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-ink-soft">{service.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="border-b border-border bg-surface">
    <div class="mx-auto max-w-(--container-max) px-4 py-14 sm:px-6">
      <PlaceholderImage
        filename="workshop-2.jpg"
        alt="Nina Karolin Nüchter bei einem Vortrag"
        label="Workshop — 3:2, hier einsetzen"
        ratio="3/2"
        width={1200}
        height={800}
        class="rounded-lg shadow-card"
      />
    </div>
  </section>

  <section class="bg-surface-alt">
    <div class="mx-auto max-w-(--container-max) px-4 py-16 text-center sm:px-6">
      <h2 class="font-sans text-2xl text-primary-strong sm:text-3xl">
        Unsicher, welcher Baustein passt?
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-ink-soft">
        Genau dafür ist das Erstgespräch da — dreißig Minuten, kostenfrei, ohne Verpflichtung.
      </p>
      <a
        href="/kontakt"
        class="mt-6 inline-block rounded-md bg-primary px-6 py-3.5 text-base font-semibold text-ink-on-primary transition-colors hover:bg-primary-strong"
      >
        Kostenfreies Erstgespräch
      </a>
    </div>
  </section>
</BaseLayout>
